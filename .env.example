# Environment Variables Example
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Cache Directory (Chuyển cache sang ổ D)
HF_HOME=D:\Models\huggingface

# Model Configuration
# Ưu tiên checkpoint Lần 4 đã giải nén từ Google Drive (100,000 mẫu)
MODEL_NAME_OR_PATH=checkpoints/bmd1905-sub-corrector
# Hoặc kéo trực tiếp từ HuggingFace Hub:
# MODEL_NAME_OR_PATH=bmd1905/vietnamese-correction-v2
# MODEL_NAME_OR_PATH=VietAI/vit5-base
# MODEL_NAME_OR_PATH=vinai/bartpho-syllable

# true = âm thầm về Rule Baseline khi nạp mô hình lỗi; false = fail-fast
USE_FALLBACK=true

DEVICE=cuda
BATCH_SIZE=8
MAX_LENGTH=128
